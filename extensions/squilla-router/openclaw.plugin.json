{
  "id": "squilla-router",
  "activation": {
    "onStartup": true
  },
  "name": "SquillaRouter",
  "description": "Routes turns on virtual routing model ids to a configured model tier via a central routing service.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "tierTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model"],
        "properties": {
          "model": { "type": "string" },
          "provider": { "type": "string" }
        }
      },
      "profile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tiers"],
        "properties": {
          "defaultTier": {
            "type": "string",
            "enum": ["c0", "c1", "c2", "c3"]
          },
          "tiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "c0": { "$ref": "#/$defs/tierTarget" },
              "c1": { "$ref": "#/$defs/tierTarget" },
              "c2": { "$ref": "#/$defs/tierTarget" },
              "c3": { "$ref": "#/$defs/tierTarget" }
            }
          }
        }
      }
    },
    "properties": {
      "profiles": {
        "description": "Keyed by the virtual routing model id that triggers routing (e.g. \"squilla/auto\"). Each profile maps abstract tiers to real models.",
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/profile" }
      },
      "sticky": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "maxUserLen": { "type": "integer", "minimum": 0 }
        }
      },
      "central": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "tenantId": { "type": "string" },
          "apiKey": { "type": "string" },
          "timeoutMs": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
