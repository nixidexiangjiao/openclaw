<mxfile host="app.diagrams.net" type="device">
  <diagram name="Config Distribution" id="squilla-cfg">
    <mxGraphModel dx="1050" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="配置下发 — tokenhub 只喂中央；插件配置走 openclaw.json" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="operator" value="运维 / CI&#10;编辑策略包 → policyVersion bump" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tokenhub" value="tokenhub（内部中控）· 按 tenant 存版本化策略配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="th_b" value="策略包：confidenceThreshold / anchors / 默认档&#10;margin / 安全网 · policyVersion（未来可按 profile 键控）" style="text;html=1;fontSize=10;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="368" y="112" width="304" height="40" as="geometry" />
        </mxCell>

        <!-- Central refresher -->
        <mxCell id="labelC" value="中央服务（每实例 · configSource）" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c_pull" value="后台定时拉取(≈30s)&#10;GET /config/policy?tenant=…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="246" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_valid" value="校验通过？&#10;(schema)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="405" y="310" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_swap" value="原子替换单槽快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="400" width="250" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c_keep" value="保留 last-known-good&#10;+ 告警（fail-open）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="323" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_hot" value="热路径 Central._route&#10;只读当前快照（绝不 per-turn 拉取）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="456" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_boot" value="兜底默认：SQUILLA_* env&#10;（引导 + tokenhub 不可达时）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="456" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="trail" value="decisionId 决策轨迹（MySQL · 无明文）记 policyVersion&#10;→ 任意一次路由都能回放它当时用的是哪版策略（可复现 / 可回滚）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="470" height="56" as="geometry" />
        </mxCell>

        <!-- Plugin config note (NOT via tokenhub) -->
        <mxCell id="pluginNote" value="OpenClaw 插件（fleet）&#10;配置 = openclaw.json（tiers / defaultTier / sticky / central 端点）&#10;启动读一次 · 不经 tokenhub · 无中控快照&#10;改 fleet 模型映射 = 用配置管理/发布流程推 openclaw.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="890" y="80" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="g1" value="发布" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="operator" target="tokenhub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" value="下发策略包（只给中央）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d6b656;" edge="1" parent="1" source="tokenhub" target="c_pull"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_pull" target="c_valid"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g10" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c_valid" target="c_swap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g11" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c_valid" target="c_keep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g12" value="更新快照" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c_swap" target="c_hot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g13" value="沿用旧快照" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="c_keep" target="c_hot">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="481" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="g15" value="policyVersion" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="c_hot" target="trail"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
