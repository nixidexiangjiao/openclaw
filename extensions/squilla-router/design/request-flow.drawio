<mxfile host="app.diagrams.net" type="device">
  <diagram name="Request Flow" id="squilla-flow">
    <mxGraphModel dx="1050" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="单轮路由流程（before_model_resolve）— 虚拟 id 触发" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="laneP" value="插件侧（index.ts）" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="110" y="55" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="laneC" value="中央侧（server.py · Central._route）" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="290" width="360" height="20" as="geometry" />
        </mxCell>

        <mxCell id="start" value="before_model_resolve(event, ctx)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="110" y="80" width="210" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d_gate" value="触发门：ctx 的 provider/modelId&#10;命中某个 profiles 虚拟 id？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="115" y="150" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="end_pass" value="未命中：真实模型&#10;不干预 → 返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="165" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note_must" value="命中后必须返回覆盖：&#10;虚拟 id 无法真实解析" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="250" width="170" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d_img" value="含图片附件？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="135" y="260" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="img_tier" value="tier = profile 最强已配置档&#10;（最可能有视觉能力；不请求中央）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="360" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d_central" value="config.central&#10;存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="call_route" value="routeRemote → POST /v1/route&#10;{tenantId, sessionKey, profile,&#10;message, attachmentCount}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c_embed" value="嵌入消息（外部 embeddings）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="635" y="400" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c_classify" value="classify_semantic：锚点余弦&#10;+ margin 升级 + 欠路由安全网" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="635" y="450" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note_embed" value="embedding 失败 →&#10;中央侧启发式兜底（照常落库）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="450" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_gate" value="置信度门（低置信→defaultTier）&#10;→ flag 升级 → final_tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="635" y="508" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_store" value="落库（MySQL · 无明文 · 含 profile 列）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="635" y="566" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c_resp" value="返回 { tier, decisionId,&#10;confidence, meta }（通用协议）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="635" y="616" width="220" height="44" as="geometry" />
        </mxCell>

        <mxCell id="d_ok" value="中央成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="440" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fallback" value="fallbackTier 粗略兜底&#10;（长度/代码猜档，中段用 profile.defaultTier）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="560" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="resolveRoute(profile, sticky, tier)&#10;就近配置档位（缺档向上，不静默降级）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="640" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sticky" value="applySticky：短续轮阻止下调&#10;（保 KV-cache）；升档放行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="710" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="setstore" value="SessionTierStore.set 本轮档位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="780" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="logret" value="log(profile, source, decisionId) → 返回&#10;modelOverride / providerOverride?" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="840" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_pass" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_gate" target="end_pass"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_hit" value="是（取 profile）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_gate" target="d_img"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_img" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_img" target="img_tier"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_img_res" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="img_tier" target="resolve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_noimg" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_img" target="d_central"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_central" value="是（中央优先）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_central" target="call_route"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_nocentral" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_central" target="fallback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1e" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="call_route" target="c_embed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2e" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_embed" target="c_classify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2n" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="c_classify" target="note_embed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3e" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_classify" target="c_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4e" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_gate" target="c_store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5e" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_store" target="c_resp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_resp" value="响应 / 超时" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="c_resp" target="d_ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_fail" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_ok" target="fallback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_ok" value="是（tier + decisionId）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_ok" target="resolve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_fb_res" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="fallback" target="resolve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_r1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="resolve" target="sticky"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_r2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="sticky" target="setstore"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f_r3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="setstore" target="logret"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
