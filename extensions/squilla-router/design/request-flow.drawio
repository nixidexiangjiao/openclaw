<mxfile host="app.diagrams.net" type="device">
  <diagram name="Request Flow" id="squilla-flow">
    <mxGraphModel dx="1050" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="单轮路由流程（before_model_resolve）" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="laneP" value="插件侧（index.ts）" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="110" y="55" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="laneC" value="中央侧（server.py · Central._route）" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="360" height="20" as="geometry" />
        </mxCell>

        <mxCell id="start" value="before_model_resolve(event)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="110" y="80" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d_img" value="含图片附件？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="150" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="end_img" value="不覆盖，保留视觉模型 → 返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="165" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d_central" value="config.central&#10;存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="255" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="call_route" value="routeRemote → POST /v1/route&#10;{tenantId, sessionKey, message, attachmentCount}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="240" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_embed" value="嵌入消息（外部 embeddings）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="625" y="310" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c_classify" value="classify_semantic：锚点余弦&#10;+ margin 升级 + 欠路由安全网" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="625" y="360" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note_embed" value="embedding 失败 →&#10;中央侧启发式兜底（照常落库）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="360" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_gate" value="置信度门（低置信→defaultTier）&#10;→ flag 升级 → final_tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="625" y="418" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_store" value="落库（MySQL · 无明文）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="625" y="476" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c_resp" value="返回 { tier, decisionId,&#10;confidence, meta }（通用协议）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="625" y="526" width="220" height="44" as="geometry" />
        </mxCell>

        <mxCell id="d_ok" value="中央成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="370" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fallback" value="classifyTurn 本地启发式（含节流告警）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="475" width="210" height="44" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="resolveRoute：就近配置档位&#10;+ 置信门（band=central 直通）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="475" width="210" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sticky" value="applySticky：短续轮阻止下调&#10;（保 KV-cache）；升档放行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="545" width="210" height="44" as="geometry" />
        </mxCell>
        <mxCell id="setstore" value="SessionTierStore.set 本轮档位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="615" width="210" height="36" as="geometry" />
        </mxCell>
        <mxCell id="logret" value="log(decisionId) → 返回&#10;modelOverride / providerOverride?" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="675" width="210" height="46" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d_img"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_img" target="end_img"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_img" target="d_central"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="是（中央优先）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_central" target="call_route"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_central" target="fallback">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="360" /><mxPoint x="445" y="360" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="call_route" target="c_embed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_embed" target="c_classify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="c_classify" target="note_embed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_classify" target="c_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_gate" target="c_store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c_store" target="c_resp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" value="响应 / 超时" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="c_resp" target="d_ok">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="590" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="f13" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_ok" target="fallback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f14" value="是（用 tier + decisionId）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d_ok" target="resolve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="fallback" target="resolve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="resolve" target="sticky"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="sticky" target="setstore"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="setstore" target="logret"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
