<mxfile host="app.diagrams.net" type="device">
  <diagram name="Architecture" id="squilla-arch">
    <mxGraphModel dx="1050" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SquillaRouter 智能路由 — 系统架构" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tokenhub" value="tokenhub（内部中控 · 配置下发）&#10;只向中央下发版本化策略配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="th_b" value="策略包：confidenceThreshold / anchors / 默认档（+policyVersion）" style="text;html=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="478" y="108" width="304" height="20" as="geometry" />
        </mxCell>

        <!-- Fleet container -->
        <mxCell id="fleetBox" value="OpenClaw 实例（可多实例 / fleet） — 瘦客户端 · 配置全来自 openclaw.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="plugin" value="squilla-router 插件（before_model_resolve）— 无路由智能" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="252" width="320" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p_img" value="图片短路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="292" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p_map" value="tier → 模型映射" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="292" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p_sticky" value="KV-cache 粘滞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="336" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p_fb" value="粗略兜底（长度/代码）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="336" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p_tx" value="会话记录 transcript（明文所在地 · 端上）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="384" width="320" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p_log" value="debug 日志：source + decisionId（与明文并排）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="428" width="320" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p_cfg" value="配置来源：openclaw.json（tiers / defaultTier / sticky / central 端点）— 启动即定，不经 tokenhub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="474" width="320" height="52" as="geometry" />
        </mxCell>

        <!-- Central container -->
        <mxCell id="centralBox" value="中央路由服务（Python · services/squilla_central） — 拥有一切决策" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="220" width="380" height="330" as="geometry" />
        </mxCell>
        <mxCell id="s_api" value="HTTP API：/v1/route · /v1/feedback · /v1/decisions · /v1/stats · /healthz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="252" width="340" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s_classify" value="classify_semantic（V4 替换接缝）&#10;锚点余弦 + margin 升级 + 欠路由安全网" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="296" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s_gate" value="置信度门 + flag 升级 → final_tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="350" width="340" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s_cfg" value="configSource：策略配置快照（单槽 · 后台刷新 · fail-open）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="394" width="340" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s_resp" value="响应（通用协议）：{ tier, decisionId, confidence, policyVersion, meta }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="438" width="340" height="34" as="geometry" />
        </mxCell>

        <!-- Privacy boundary + MySQL -->
        <mxCell id="privacy" value="隐私边界：库内无明文" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;fontColor=#b85450;verticalAlign=top;fontStyle=2;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="460" y="580" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="MySQL — decisions / feedback&#10;仅派生数据（无消息文本列）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="608" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Embeddings -->
        <mxCell id="embed" value="Embeddings 服务&#10;（OpenAI 兼容 · TEI + bge）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="300" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_route" value="POST /v1/route（明文 · 内部网）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="plugin" target="s_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_resp" value="tier + decisionId（返回）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="s_resp" target="p_map">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_embed" value="embed 消息" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="s_classify" target="embed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_store" value="insert decision（无明文）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="s_resp" target="mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_thB" value="下发策略包（定时拉取 · fail-open）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1" source="tokenhub" target="s_cfg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
